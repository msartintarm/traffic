{
  "name": "traffic-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "wasm:build": "node scripts/build-wasm.mjs single",
    "wasm:build:threads": "node scripts/build-wasm.mjs threads",
    "wasm:build:all": "npm run wasm:build && (npm run wasm:build:threads || echo 'threads build unavailable (needs nightly + build-std); single-threaded only')",
    "predev": "npm run wasm:build:all",
    "dev": "next dev -p 3000",
    "dev:threads": "npm run wasm:build:threads && npm run dev",
    "prebuild": "npm run wasm:build:all",
    "build": "next build",
    "start": "next start",
    "test": "node --test src/lib/*.test.ts"
  },
  "type": "module",
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
